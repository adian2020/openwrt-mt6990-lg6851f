-	dev->hw->pcie_base = mtk_wed_get_pcie_base(dev);
+	if (!hw->pcie_route)
+		hw->pcie_base = mtk_wed_get_pcie_base(dev);

 	ret = dma_set_mask_and_coherent(hw->dev, DMA_BIT_MASK(32));
 	if (ret)
@@ -2465,7 +2544,9 @@ mtk_wed_attach(struct mtk_wed_device *dev)
 			goto out;
 	}

-	mtk_wed_hw_init_early(dev);
+	ret = mtk_wed_hw_init_early(dev);
+	if (ret)
+		goto out;
 	if (mtk_wed_is_v1(hw))
 		regmap_update_bits(hw->hifsys, HIFSYS_DMA_AG_MAP,
 				   BIT(hw->index), 0);
@@ -2474,6 +2555,8 @@ mtk_wed_attach(struct mtk_wed_device *dev)

 	if (mtk_wed_get_rx_capa(dev))
 		ret = mtk_wed_wo_init(hw);
+	else if (hw->pcie_route)
+		dev_info(device, "attached MT6990 WED%d TX path\n", hw->index);
 out:
 	if (ret) {
 		dev_err(dev->hw->dev, "failed to attach wed device\n");
@@ -2851,10 +2934,24 @@ void mtk_wed_add_hw(struct device_node *np, struct mtk_eth *eth,
 	hw->wdma = wdma;
 	hw->index = index;
 	hw->irq = irq;
-	hw->version = eth->soc->version;
+	/* WED uses v2 rings independently of the Ethernet descriptors. */
+	hw->version = MTK_HAS_CAPS(eth->soc->caps, MTK_SOC_MT6990) ?
+		      2 : eth->soc->version;

 	switch (hw->version) {
 	case 2:
+		if (MTK_HAS_CAPS(eth->soc->caps, MTK_SOC_MT6990)) {
+			u32 route[2];
+
+			hw->pcie_route = syscon_regmap_lookup_by_phandle_args(np,
+				"mediatek,pcie-route", ARRAY_SIZE(route), route);
+			if (IS_ERR(hw->pcie_route) || !route[1] || (route[0] & 3)) {
+				kfree(hw);
+				goto unlock;
+			}
+			hw->pcie_route_reg = route[0];
+			hw->pcie_route_mask = route[1];
+		}
 		hw->soc = &mt7986_data;
 		break;
 	case 3:
