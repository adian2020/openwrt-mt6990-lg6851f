+static int
+mtk_wed_mt6990_pcie_base(struct mtk_wed_device *dev, u32 *base)
+{
+	struct pci_host_bridge *bridge;
+	struct device_node *np;
+	struct resource res;
+
+	if (dev->wlan.bus_type != MTK_WED_BUS_PCIE || dev->wlan.msi)
+		return -EOPNOTSUPP;
+
+	bridge = pci_find_host_bridge(dev->wlan.pci_dev->bus);
+	if (!bridge || !bridge->dev.parent)
+		return -ENODEV;
+
+	np = bridge->dev.parent->of_node;
+	if (!np || !of_device_is_compatible(np, "mediatek,mt6990-pcie") ||
+	    of_address_to_resource(np, 0, &res) ||
+	    resource_size(&res) < 0x188 || res.start > U32_MAX - 0x184)
+		return -EINVAL;
+
+	*base = res.start;
+	return 0;
+}
