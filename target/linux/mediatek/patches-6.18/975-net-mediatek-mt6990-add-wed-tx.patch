 static int
 mtk_wed_attach(struct mtk_wed_device *dev)
 	__releases(RCU)
@@ -2433,6 +2500,17 @@ mtk_wed_attach(struct mtk_wed_device *dev)
 	device = dev->wlan.bus_type == MTK_WED_BUS_PCIE
 		? &dev->wlan.pci_dev->dev
 		: &dev->wlan.platform_dev->dev;
+	if (hw->pcie_route) {
+		ret = mtk_wed_mt6990_pcie_base(dev, &hw->pcie_base);
+		if (ret) {
+			dev_warn(device, "WED%d PCIe resources unavailable: %d\n",
+				 hw->index, ret);
+			hw->wed_dev = NULL;
+			module_put(THIS_MODULE);
+			goto unlock;
+		}
+		dev->wlan.tx_only = true;
+	}
 	dev_info(device, "attaching wed device %d version %d\n",
 		 hw->index, hw->version);

