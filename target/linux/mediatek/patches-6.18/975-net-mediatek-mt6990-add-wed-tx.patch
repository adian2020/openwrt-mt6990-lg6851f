+static int mtk_wed_mt6990_pcie_init(struct mtk_wed_device *dev)
+{
+	struct mtk_wed_hw *hw = dev->hw;
+	int ret;
+
+	ret = regmap_read(hw->pcie_route, hw->pcie_route_reg,
+			  &hw->pcie_route_saved);
+	if (ret)
+		return ret;
+
+	wed_w32(dev, MTK_WED_PCIE_CFG_INTM, hw->pcie_base + 0x180);
+	wed_w32(dev, MTK_WED_PCIE_CFG_BASE, hw->pcie_base + 0x184);
+	wed_w32(dev, MTK_WED_PCIE_INT_TRIGGER, BIT(24));
+	wed_w32(dev, MTK_WED_PCIE_INT_CTRL,
+		FIELD_PREP(MTK_WED_PCIE_INT_CTRL_POLL_EN, 2) |
+		MTK_WED_PCIE_INT_CTRL_MSK_EN_POLA |
+		FIELD_PREP(MTK_WED_PCIE_INT_CTRL_SRC_SEL, hw->index));
+
+	ret = regmap_update_bits(hw->pcie_route, hw->pcie_route_reg,
+				 hw->pcie_route_mask, hw->pcie_route_mask);
+	if (!ret)
+		hw->pcie_route_active = true;
+
+	return ret;
+}
+
