#!/bin/sh /etc/rc.common
START=97
STOP=10
USE_PROCD=1
start_service() {
 rm -f /var/run/lg6851f-fair-qos.stopped
 /usr/sbin/lg6851f-fair-qos apply
}
reload_service() { /usr/sbin/lg6851f-fair-qos apply; }
stop_service() {
 # Set intent BEFORE waiting on a concurrent setup transaction.
 touch /var/run/lg6851f-fair-qos.stopped
 /usr/sbin/lg6851f-fair-qos stop
}
service_triggers() { procd_add_reload_trigger lg6851f_fair_qos network; }
