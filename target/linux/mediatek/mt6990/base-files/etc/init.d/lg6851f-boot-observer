#!/bin/sh /etc/rc.common
# Observe asynchronously before S09 storage and S10 kmodloader, never reorder them.
START=08
USE_PROCD=1
start_service() {
 procd_open_instance
 procd_set_param command /usr/sbin/lg6851f-boot-observer
 procd_set_param stdout 0
 procd_set_param stderr 1
 procd_set_param term_timeout 3
 procd_close_instance
}
