#!/bin/sh

[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "fiberhome,lg6851f" ] || exit 0

# Settings are preserved across sysupgrade, so migrate the original
# numbered CCMNI defaults to the logical interface and stable IFB names.
if uci -q get lg6851f_fair_qos.main >/dev/null; then
	# Upgrade preserved configurations from the former default-off release once.
	if [ "$(uci -q get lg6851f_fair_qos.main.safety_opt_in_version)" = 1 ]; then
		uci set lg6851f_fair_qos.main.enabled='1' || exit 1
		uci -q delete lg6851f_fair_qos.main.safety_opt_in_version || exit 1
	fi
	uci set lg6851f_fair_qos.main.network_interface='modem5g' || exit 1
	uci set lg6851f_fair_qos.main.ifb_device='ifb-cellular' || exit 1
	uci -q delete lg6851f_fair_qos.main.wan_device
	uci commit lg6851f_fair_qos || exit 1
fi

/etc/init.d/lg6851f_fair_qos enable || exit 1
exit 0
