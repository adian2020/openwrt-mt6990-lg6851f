+	if (boot_trace_active)
+		lg6851f_boot_trace("ubus-register-end", "udebug");
 	ctx->connection_lost = ubus_disconnect_cb;
+	if (boot_trace_active)
+		lg6851f_boot_trace("ubus-register-begin", "hotplug");
 	ubus_init_hotplug(ctx);
+	if (boot_trace_active)
+		lg6851f_boot_trace("ubus-register-end", "hotplug");
+	if (boot_trace_active)
+		lg6851f_boot_trace("ubus-register-begin", "service");
 	ubus_init_service(ctx);
+	if (boot_trace_active)
+		lg6851f_boot_trace("ubus-register-end", "service");
+	if (boot_trace_active)
+		lg6851f_boot_trace("ubus-register-begin", "system");
 	ubus_init_system(ctx);
+	if (boot_trace_active)
+		lg6851f_boot_trace("ubus-register-end", "system");
+	if (boot_trace_active)
+		lg6851f_boot_trace("ubus-register-begin", "watch");
 	watch_ubus(ctx);
+	if (boot_trace_active)
+		lg6851f_boot_trace("ubus-register-end", "watch");
 
 	DEBUG(2, "Connected to ubus, id=%08x\n", ctx->local_id);
 	reset_timeout();
 	ubus_add_uloop(ctx);
+	if (boot_trace_active)
+		lg6851f_boot_trace("ubus-initial-ready", "attempts=%u", boot_connect_attempts);
+	boot_trace_active = false;
 	procd_state_ubus_connect();
 }
 
 void
 procd_connect_ubus(void)
 {
+	lg6851f_boot_trace("ubus-connect-scheduled", "first_delay_ms=50");
 	ubus_timer.cb = ubus_connect_cb;
 	reset_timeout();
 	timeout_retry();
