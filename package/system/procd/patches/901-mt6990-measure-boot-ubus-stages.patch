 {
+	if (boot_trace_active) {
+		boot_connect_attempts++;
+		if (boot_connect_attempts <= 32)
+			lg6851f_boot_trace("ubus-connect-begin", "attempt=%u", boot_connect_attempts);
+	}
 	ctx = ubus_connect(ubus_socket);
+	if (boot_trace_active && boot_connect_attempts <= 32)
+		lg6851f_boot_trace("ubus-connect-end", "attempt=%u success=%d", boot_connect_attempts, ctx != NULL);
 
 	if (!ctx) {
 		DEBUG(4, "Connection to ubus failed\n");
@@ -74,22 +84,46 @@
 		return;
 	}
 
+	if (boot_trace_active)
+		lg6851f_boot_trace("ubus-register-begin", "udebug");
