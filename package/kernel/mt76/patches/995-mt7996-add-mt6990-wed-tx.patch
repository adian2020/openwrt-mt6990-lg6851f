Subject: mt76: mt7996: support opt-in MT6990 WED TX

On MT6990, keep WED v3 RRO disabled and use the WED v2.3 HIF TX
descriptor format. Leave PCI probe to select the existing WED or
normal PCI path.

Based on the TX setup in LG6851F-Pro 0e1518ed.

diff --git a/mt7996/init.c b/mt7996/init.c
index 07291cf..c670af6 100644
--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -611,6 +611,7 @@ static void mt7996_mac_init_basic_rates(struct mt7996_dev *dev)
 void mt7996_mac_init(struct mt7996_dev *dev)
 {
 #define HIF_TXD_V2_1	0x21
+#define HIF_TXD_V0_1	0x01
 	struct mt7996_phy *phy;
 	int i, rx_path_type;

@@ -653,6 +654,8 @@ void mt7996_mac_init(struct mt7996_dev *dev)

 	mt7996_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(SET),
 			  MCU_WA_PARAM_HW_PATH_HIF_VER,
+			  mtk_wed_device_active(&dev->mt76.mmio.wed) &&
+			  dev->mt76.mmio.wed.wlan.tx_only ? HIF_TXD_V0_1 :
 			  HIF_TXD_V2_1, 0);

 	for (i = MT_BAND0; i <= MT_BAND2; i++)
diff --git a/mt7996/mmio.c b/mt7996/mmio.c
index 1f7355c..a4c11c9 100644
--- a/mt7996/mmio.c
+++ b/mt7996/mmio.c
@@ -6,6 +6,7 @@
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/pci.h>
+#include <linux/of.h>
 #include <linux/rtnetlink.h>

 #include "mt7996.h"
@@ -16,6 +17,7 @@

 static bool wed_enable;
 module_param(wed_enable, bool, 0644);
+MODULE_PARM_DESC(wed_enable, "Enable WED at PCI probe (default: disabled)");

 static const struct __base mt7996_reg_base[] = {
 	[WF_AGG_BASE]		= { { 0x820e2000, 0x820f2000, 0x830e2000 } },
@@ -453,19 +455,38 @@ out:
 }
 #endif

+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+static u32 mt7996_mt6990_hif2_init_buf(void *ptr, dma_addr_t phys, int token)
+{
+	u32 len = mt7996_wed_init_buf(ptr, phys, token);
+	__le32 *txd = ptr;
+
+	/* MT6990 WED 2.3 marks the secondary HIF in TXD6 SRC[9:8]. */
+	txd[6] |= cpu_to_le32(BIT(8));
+	return len;
+}
+#endif
+
 int mt7996_mmio_wed_init(struct mt7996_dev *dev, void *pdev_ptr,
 			 bool hif2, int *irq)
 {
 #ifdef CONFIG_NET_MEDIATEK_SOC_WED
 	struct mtk_wed_device *wed = &dev->mt76.mmio.wed;
 	struct pci_dev *pci_dev = pdev_ptr;
+	bool mt6990 = of_machine_is_compatible("mediatek,mt6990");
 	u32 hif1_ofs;

 	if (!wed_enable)
 		return 0;

-	dev->mt76.hwrro_mode = is_mt7996(&dev->mt76) ? MT76_HWRRO_V3
-						     : MT76_HWRRO_V3_1;
+	if (mt6990) {
+		if (hif2 && !mtk_wed_device_active(wed))
+			return 0;
+		dev->mt76.hwrro_mode = MT76_HWRRO_OFF;
+	} else {
+		dev->mt76.hwrro_mode = is_mt7996(&dev->mt76) ?
+				       MT76_HWRRO_V3 : MT76_HWRRO_V3_1;
+	}

 	hif1_ofs = dev->hif2 ? MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0) : 0;

@@ -587,7 +608,8 @@ int mt7996_mmio_wed_init(struct mt7996_dev *dev, void *pdev_ptr,
 			wed->wlan.wpdma_txfree = wed->wlan.phy_base + MT_RXQ_RING_BASE(0) +
 						  MT7996_RXQ_MCU_WA_MAIN * MT_RING_SIZE;
 		}
-		dev->mt76.rx_token_size = MT7996_TOKEN_SIZE + wed->wlan.rx_npkt;
+		if (!mt6990)
+			dev->mt76.rx_token_size = MT7996_TOKEN_SIZE + wed->wlan.rx_npkt;

 		if (dev->hif2 && is_mt7992(&dev->mt76))
 			wed->wlan.id = 0x7992;
@@ -600,7 +622,8 @@ int mt7996_mmio_wed_init(struct mt7996_dev *dev, void *pdev_ptr,
 	wed->wlan.amsdu_max_subframes = 8;
 	wed->wlan.amsdu_max_len = 1536;

-	wed->wlan.init_buf = mt7996_wed_init_buf;
+	wed->wlan.init_buf = mt6990 && hif2 ? mt7996_mt6990_hif2_init_buf :
+			     mt7996_wed_init_buf;
 	wed->wlan.init_rx_buf = mt76_wed_init_rx_buf;
 	wed->wlan.release_rx_buf = mt76_wed_release_rx_buf;
 	wed->wlan.offload_enable = mt76_wed_offload_enable;
