#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service() {
 case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in fiberhome,lg6851f|fiberhome_lg6851f) ;; *) return 0 ;; esac
 procd_open_instance
 procd_set_param command /usr/bin/ucode /usr/libexec/lg6851f-sms-pool.uc run
 procd_set_param respawn 3600 5 5
 procd_set_param term_timeout 45
 procd_set_param stdout 0
 procd_set_param stderr 1
 procd_close_instance
}
