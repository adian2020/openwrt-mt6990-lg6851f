#!/bin/sh /etc/rc.common
START=98
STOP=10
USE_PROCD=1

start_service() {
	config_load lg6851f_sms_forward
	local enabled
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/libexec/lg6851f-sms-forward.uc run
	procd_set_param respawn 3600 10 5
	procd_set_param term_timeout 40
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lg6851f_sms_forward
}
